# ==============================================================================
# FinSaarthi Environment Configuration (Example Template)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE & SUPABASE CLOUD CONFIGURATION
# ------------------------------------------------------------------------------
# FinSaarthi natively supports Supabase PostgreSQL and standard PostgreSQL.
#
# Option A - Supabase Connection Pooler (Recommended):
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
#
# Option B - Supabase Direct Connection:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
#
# Local Fallback (automatically active if PostgreSQL/Supabase is unreachable):
SQLITE_FALLBACK_URL=sqlite:///./finsaarthi.db

# Supabase REST / Storage Client (Optional, for direct SDK operations):
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key

# ------------------------------------------------------------------------------
# 2. REDIS CACHE & CELERY TASK QUEUE
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 3. VECTOR DATABASE (ChromaDB Multilingual BGE-M3)
# ------------------------------------------------------------------------------
CHROMA_PERSIST_DIRECTORY=./backend/data/chroma_db

# ------------------------------------------------------------------------------
# 4. GOOGLE GEMINI AI LLM API
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 5. GOVERNMENT BHASHINI MULTILINGUAL PIPELINE (EN, HI, MR)
# ------------------------------------------------------------------------------
BHASHINI_API_KEY=your_bhashini_api_key_here
BHASHINI_USER_ID=your_bhashini_user_id_here
BHASHINI_PIPELINE_ID=your_bhashini_pipeline_id_here
BHASHINI_BASE_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline
DEMO_MODE=true

# ------------------------------------------------------------------------------
# 6. AUTHENTICATION & SECURITY (JWT)
# ------------------------------------------------------------------------------
JWT_SECRET=your_jwt_secret_key_here
JWT_ALGORITHM=HS256

# ------------------------------------------------------------------------------
# 7. DOCUMENT UPLOAD & OCR STORAGE
# ------------------------------------------------------------------------------
UPLOAD_DIR=./backend/data/uploads

# ------------------------------------------------------------------------------
# 8. WORKERS & OFFLINE RESILIENCE
# ------------------------------------------------------------------------------
ENABLE_CELERY_ASYNC=false
ENABLE_LOCAL_WHISPER=false
USE_LOCAL_HF_MODEL=false
